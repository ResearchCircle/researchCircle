# Shared runtime settings. Startup applies existing migrations and verifies schema.
TBR_PROFILE=demo
TBR_MODEL_PROVIDER=local
TBR_DEV_IDENTITY=false
# Reachable FROM the containers; host localhost does not refer to Orin.
TBR_MODEL_BASE_URL=
TBR_MODEL_ID=homelab-llm
# Platform-lead builds using reviewed T2 dependencies and the frontend npm lock.
# Build with: python -m deployment.build
TBR_API_IMAGE=
TBR_WEB_IMAGE=
# Persisted-job worker; startup is gated on verified database schema.
TBR_WORKER_MODULE=services.worker.generate
TBR_DB_PASSWORD=
TBR_HTTP_PORT=8080
# Set https only behind a trusted TLS front door preserving the browser Host.
# This is the browser-facing scheme; the loopback proxy itself speaks HTTP.
TBR_PUBLIC_SCHEME=http
# On the host, keep source and working paths separate. Replace as needed.
TBR_DATA_SOURCE=./data
TBR_DATA_WORK=/tmp/tbr-v2-work
