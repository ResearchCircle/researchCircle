# ──────────────────────────────────────────────────────────────────────────────
# Python (github.com/github/gitignore/blob/main/Python.gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
!frontend/src/lib/**
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
.playwright-mcp/
cover/

# Translations
*.mo
*.pot

# Django / Flask / Scrapy
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
.scrapy

# Sphinx documentation
docs/_build/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Environments
.env
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
__pypackages__/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# Mypy / Pyre / Pytype
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Ruff / other linters
.ruff_cache/
.pypirc

# Streamlit secrets (keep .streamlit/ config but not secrets)
.streamlit/secrets.toml

# macOS
.DS_Store
**/.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# ──────────────────────────────────────────────────────────────────────────────
# TigerResearchBuddy — Project-specific
# ──────────────────────────────────────────────────────────────────────────────

# Secrets — keep example for onboarding
.env
!.env.example

# --- Collected data: never commit --------------------------------------------
# Default deny, so a new corpus, database or export cannot be published by
# accident. Only small reviewed reference files are tracked.
data/*
!data/.gitkeep
!data/prompts/
!data/taxonomies/

# --- Caches ------------------------------------------------------------------
.cache/

# --- Runtime artifacts -------------------------------------------------------
# Dagster temp dirs
.tmp_dagster_home_*/

# Data backups
data_backup_*/

# Logs
logs/

tests/output/

# --- Temporary Dumps ---
notebookllm_source.txt
frontend_dump_for_figma.txt
